; Wraps the Windows build into one setup.exe.
; makensis is given BUNDLE, ROOMS, VERSION and OUTFILE with -D flags.

Unicode true
SetCompressor /SOLID lzma

!include Sections.nsh
!include nsDialogs.nsh
!include LogicLib.nsh

Name "RoomWare ${VERSION}"
OutFile "${OUTFILE}"
Icon "escapeonmain.ico"
UninstallIcon "escapeonmain.ico"
InstallDir "$PROGRAMFILES64\RoomWare"
InstallDirRegKey HKLM "Software\RoomWare" "InstallDir"
; Writing to Program Files and HKLM needs it.
RequestExecutionLevel admin
ShowInstDetails show
ShowUnInstDetails show

!define UNINSTALL_KEY "Software\Microsoft\Windows\CurrentVersion\Uninstall\RoomWare"
; RoomWare reads the web page's password from here, see src/server/mod.rs.
!define PASSWORD_FILE "$INSTDIR\password.txt"

ComponentText "Choose the room this computer runs."

Page components
Page directory
; After the directory page, so it checks for a password where this install goes.
Page custom PasswordPage PasswordPageLeave ": Web Page Password"
Page instfiles
UninstPage uninstConfirm
UninstPage instfiles

; Section index of the room currently picked on the components page.
Var Room
Var PasswordBox
; Empty keeps the password an earlier install saved.
Var Password

Section "-RoomWare"
  SetOutPath "$INSTDIR"
  File /r "${BUNDLE}/*"

  ; RoomWare saves its web server certificate here on first run, without admin rights.
  CreateDirectory "$INSTDIR\certs"
  nsExec::Exec 'icacls "$INSTDIR\certs" /grant *S-1-5-32-545:(OI)(CI)M /T'

  ; UTF-16, since FileWrite would squash the password into the ANSI code page.
  ${If} $Password != ""
    FileOpen $0 "${PASSWORD_FILE}" w
    FileWriteUTF16LE /BOM $0 "$Password"
    FileClose $0
  ${EndIf}

  WriteRegStr HKLM "Software\RoomWare" "InstallDir" "$INSTDIR"
  WriteRegStr HKLM "${UNINSTALL_KEY}" "DisplayName" "RoomWare"
  WriteRegStr HKLM "${UNINSTALL_KEY}" "DisplayVersion" "${VERSION}"
  WriteRegStr HKLM "${UNINSTALL_KEY}" "DisplayIcon" "$INSTDIR\bin\roomware.exe"
  WriteRegStr HKLM "${UNINSTALL_KEY}" "UninstallString" '"$INSTDIR\uninstall.exe"'
  WriteRegStr HKLM "${UNINSTALL_KEY}" "InstallLocation" "$INSTDIR"
  WriteRegDWORD HKLM "${UNINSTALL_KEY}" "NoModify" 1
  WriteRegDWORD HKLM "${UNINSTALL_KEY}" "NoRepair" 1

  WriteUninstaller "$INSTDIR\uninstall.exe"
SectionEnd

; Body of each room's section in rooms.nsh. Replaces whichever room an
; earlier install left behind and points the shortcut at this one.
!macro InstallRoom ROOM
  RMDir /r "$INSTDIR\rooms"
  SetOutPath "$INSTDIR\rooms\${ROOM}"
  File /r "${ROOMS}/${ROOM}/*"

  ; Older installers put the shortcut in the elevating user's menu.
  SetShellVarContext current
  Delete "$SMPROGRAMS\RoomWare.lnk"
  SetShellVarContext all

  ; RoomWare updates the room itself, which runs without admin rights.
  nsExec::Exec 'icacls "$INSTDIR\rooms" /grant *S-1-5-32-545:(OI)(CI)M /T'

  CreateShortcut "$SMPROGRAMS\RoomWare.lnk" "$INSTDIR\bin\roomware.exe" "${ROOM}"
!macroend

; Generated by installer.nix: one section per directory in rooms/, plus
; FIRST_ROOM and the RoomRadioButtons macro.
!include "rooms.nsh"

Function .onInit
  ; Puts the shortcut in every user's Start Menu instead of the admin's.
  SetShellVarContext all
  StrCpy $Room ${FIRST_ROOM}
FunctionEnd

Function PasswordPage
  nsDialogs::Create 1018
  Pop $0

  ${If} ${FileExists} "${PASSWORD_FILE}"
    StrCpy $1 "Password for logging in on RoomWare's web page. Leave it empty to keep the current one."
  ${Else}
    StrCpy $1 "Password for logging in on RoomWare's web page."
  ${EndIf}
  ${NSD_CreateLabel} 0 0 100% 24u $1
  Pop $0

  ${NSD_CreatePassword} 0 30u 100% 12u $Password
  Pop $PasswordBox
  ${NSD_SetFocus} $PasswordBox

  nsDialogs::Show
FunctionEnd

Function PasswordPageLeave
  ${NSD_GetText} $PasswordBox $Password

  ${If} $Password == ""
  ${AndIfNot} ${FileExists} "${PASSWORD_FILE}"
    MessageBox MB_ICONEXCLAMATION|MB_OK "Enter a password, the web page can't be used without one."
    Abort
  ${EndIf}
FunctionEnd

Function .onSelChange
  !insertmacro StartRadioButtons $Room
    !insertmacro RoomRadioButtons
  !insertmacro EndRadioButtons
FunctionEnd

Function un.onInit
  SetShellVarContext all
FunctionEnd

Section "Uninstall"
  Delete "$SMPROGRAMS\RoomWare.lnk"
  RMDir /r "$INSTDIR"
  DeleteRegKey HKLM "Software\RoomWare"
  DeleteRegKey HKLM "${UNINSTALL_KEY}"
SectionEnd
